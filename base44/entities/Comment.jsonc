{
  "name": "Comment",
  "type": "object",
  "properties": {
    "rootEntityType": {
      "type": "string",
      "enum": [
        "suggestion",
        "argument",
        "section",
        "document"
      ],
      "description": "Type of entity being commented on"
    },
    "rootEntityId": {
      "type": "string",
      "description": "ID of entity being commented on"
    },
    "parentCommentId": {
      "type": "string",
      "description": "Parent comment ID for replies"
    },
    "content": {
      "type": "string",
      "description": "Comment content"
    },
    "originalLanguage": {
      "type": "string",
      "enum": [
        "en",
        "he",
        "ar"
      ],
      "default": "he",
      "description": "Original language of the content"
    },
    "likes": {
      "type": "array",
      "description": "Array of user emails who liked this comment",
      "default": [],
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "rootEntityType",
    "rootEntityId",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}