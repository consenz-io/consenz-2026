{
  "name": "TopicEditVote",
  "type": "object",
  "properties": {
    "suggestionId": {
      "type": "string",
      "description": "Topic edit suggestion being voted on"
    },
    "userId": {
      "type": "string",
      "description": "User who voted"
    },
    "vote": {
      "type": "string",
      "enum": [
        "pro",
        "con"
      ],
      "description": "Vote direction"
    }
  },
  "required": [
    "suggestionId",
    "userId",
    "vote"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}