{
  "name": "ConvincedClick",
  "type": "object",
  "properties": {
    "argumentId": {
      "type": "string",
      "description": "Argument ID"
    },
    "userId": {
      "type": "string",
      "description": "User who was convinced"
    }
  },
  "required": [
    "argumentId",
    "userId"
  ],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}