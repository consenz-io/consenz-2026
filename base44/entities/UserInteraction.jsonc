{
  "name": "UserInteraction",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "description": "Document ID"
    },
    "userId": {
      "type": "string",
      "description": "User ID"
    },
    "firstInteractionAt": {
      "type": "string",
      "format": "date-time",
      "description": "First interaction timestamp"
    }
  },
  "required": [
    "documentId",
    "userId"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}