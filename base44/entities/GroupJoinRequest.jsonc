{
  "name": "GroupJoinRequest",
  "type": "object",
  "permissions": {
    "create": "authenticated",
    "read": "authenticated",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "properties": {
    "groupId": {
      "type": "string",
      "description": "Group ID"
    },
    "userId": {
      "type": "string",
      "description": "User ID requesting to join"
    },
    "userEmail": {
      "type": "string",
      "description": "User email"
    },
    "userName": {
      "type": "string",
      "description": "User full name"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    }
  },
  "required": [
    "groupId",
    "userId",
    "userEmail",
    "userName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}