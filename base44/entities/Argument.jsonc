{
  "name": "Argument",
  "type": "object",
  "properties": {
    "suggestionId": {
      "type": "string",
      "description": "Parent suggestion ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "pro",
        "con"
      ],
      "description": "Argument stance"
    },
    "content": {
      "type": "string",
      "description": "Argument content"
    },
    "convincedCount": {
      "type": "number",
      "default": 0,
      "description": "Number of users convinced by this argument"
    }
  },
  "required": [
    "suggestionId",
    "type",
    "content"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}