{
  "name": "DocumentAdmin",
  "type": "object",
  "properties": {
    "documentId": {
      "type": "string",
      "description": "Document ID"
    },
    "userId": {
      "type": "string",
      "description": "Admin user ID"
    }
  },
  "required": [
    "documentId",
    "userId"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}