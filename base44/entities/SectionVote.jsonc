{
  "name": "SectionVote",
  "type": "object",
  "permissions": {
    "create": "authenticated",
    "read": "public",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "properties": {
    "sectionId": {
      "type": "string",
      "description": "Section ID being voted on"
    },
    "userId": {
      "type": "string",
      "description": "User ID who voted"
    },
    "vote": {
      "type": "string",
      "enum": [
        "pro",
        "con",
        "abstain"
      ],
      "enumColors": [
        "green",
        "red",
        "gray"
      ],
      "description": "Vote direction. 'abstain' records an explicit withdrawal of the user's vote, so a vote inherited from the accepted suggestion that created the section is not counted for them either."
    }
  },
  "required": [
    "sectionId",
    "userId",
    "vote"
  ],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}