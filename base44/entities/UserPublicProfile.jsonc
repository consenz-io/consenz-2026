{
  "name": "UserPublicProfile",
  "type": "object",
  "permissions": {
    "create": "authenticated",
    "read": "public",
    "update": "authenticated",
    "delete": "authenticated"
  },
  "properties": {
    "userId": {
      "type": "string",
      "description": "User ID reference"
    },
    "email": {
      "type": "string",
      "description": "User email for lookups"
    },
    "fullName": {
      "type": "string",
      "description": "User display name"
    },
    "avatar": {
      "type": "string",
      "description": "Avatar URL (optional)"
    },
    "nameChangedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the user's one-time display name change. If set, the name cannot be changed again."
    }
  },
  "required": [
    "userId",
    "email",
    "fullName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}